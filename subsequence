public class Main
{
    private static void gss(String str,String ans){
        if(str.length()==0){
            System.out.println(ans);
            return;
        }
        char ch=str.charAt(0);
        String ros=str.substring(1);
        gss(ros,ans+ch);
        gss(ros,ans);
    }
	public static void main(String[] args) {
	    gss("abc"," ");
		System.out.println("Done with gss");
	}
}
/// output
 abc
 ab
 ac
 a
 bc
 b
 c
 
Done with gss
